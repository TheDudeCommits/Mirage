# Authentication Configuration for AskMira AI

# Base URL for the application (change for production)
NEXTAUTH_URL=http://localhost:5000

# JWT Secret (generate a strong secret for production)
NEXTAUTH_SECRET=your-super-secret-jwt-key-here-generate-a-strong-one

# Twitter OAuth (X) Configuration
# Get these from: https://developer.twitter.com/en/portal/dashboard
# 1. Create a new project and app
# 2. Navigate to "Keys and tokens" tab
# 3. Generate API Key and Secret (OAuth 1.0a)
# 4. Add callback URL: http://localhost:5000/api/auth/callback/twitter (or your domain for production)
TWITTER_CLIENT_ID=cVRsY2toRE44dnc1LUw0NmVmS0Y6MTpjaQ
TWITTER_CLIENT_SECRET=vzjb6fh_N18pIRUxdCc9QeVp-9EMj9M2Z1hSfpjBZxfuui-Tuu

# WalletConnect Project ID
# Get this from: https://cloud.walletconnect.com
# 1. Create a new project
# 2. Copy the Project ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Development Notes:
# - For production, change NEXTAUTH_URL to your actual domain
# - Generate a strong NEXTAUTH_SECRET using: openssl rand -base64 32
# - Twitter callback URL format: https://yourdomain.com/api/auth/callback/twitter
# - Make sure to add your domain to Twitter app settings