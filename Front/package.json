  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "contract:compile": "cd contracts && npx hardhat compile",
    "contract:test": "cd contracts && npx hardhat test",
    "contract:test:gas": "cd contracts && REPORT_GAS=true npx hardhat test",
    "contract:deploy:testnet": "cd contracts && npx hardhat run scripts/deploy.ts --network baseSepolia",
    "contract:deploy:mainnet": "cd contracts && npx hardhat run scripts/deploy.ts --network base",
    "contract:verify:testnet": "cd contracts && npx hardhat run scripts/verify.ts --network baseSepolia",
    "contract:verify:mainnet": "cd contracts && npx hardhat run scripts/verify.ts --network base"
  },
